{
  "name": "@moritzbrantner/settings-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Settings Playground: a realistic browser consumer of @moritzbrantner/settings-browser",
  "type": "module",
  "scripts": {
    "build:browser-package": "node ./scripts/build-browser-package.mjs",
    "build": "bun run build:browser-package && vite build",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "bun run build:browser-package && vite",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "serve:e2e": "bun run build && bun run preview",
    "test:architecture": "node --test architecture.test.mjs ../reference-ui-unchanged.test.mjs",
    "test:e2e": "playwright test --workers=1"
  },
  "dependencies": {
    "@moritzbrantner/input-bindings": "github:moritzbrantner/input-bindings#5e4f5fcb3e5aa70ad6131a2e9d2f902462092347",
    "@moritzbrantner/input-bindings-react": "github:moritzbrantner/input-bindings#3082a0b30ff57b428336e0fda9d1b584dc6ee9e8",
    "@moritzbrantner/three-d-renderer": "github:moritzbrantner/3d-lab#a9aea5ec5b0b0832b052cfd60d070c0ffd0c6261",
    "@moritzbrantner/ui": "git+https://github.com/moritzbrantner/ui.git#53f6d7839f5ffbf7d00b197b9f322927e497fb2b",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "xstate": "5.33.3"
  },
  "trustedDependencies": [
    "@moritzbrantner/ui"
  ]
}
