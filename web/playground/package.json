{
  "name": "@moritzbrantner/settings-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Settings Playground: a realistic browser consumer of @moritzbrantner/settings-browser",
  "type": "module",
  "scripts": {
    "build:browser-package": "node ./scripts/build-browser-package.mjs",
    "build": "bun run build:browser-package && bun run fetch:scene-kit && vite build",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "dev": "bun run build:browser-package && bun run fetch:scene-kit && vite",
    "fetch:scene-kit": "node ./scripts/fetch-scene-kit.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "serve:e2e": "bun run build && bun run preview",
    "test:architecture": "node --test architecture.test.mjs scripts/fetch-scene-kit.test.mjs ../reference-ui-unchanged.test.mjs",
    "test:e2e": "playwright test --workers=1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@moritzbrantner/input-bindings": "github:moritzbrantner/input-bindings#5e4f5fcb3e5aa70ad6131a2e9d2f902462092347",
    "@moritzbrantner/input-bindings-react": "github:moritzbrantner/input-bindings#3082a0b30ff57b428336e0fda9d1b584dc6ee9e8",
    "@moritzbrantner/three-d-renderer": "github:moritzbrantner/3d-lab#357b9bd8fc0bd7efaf9df4c75daab683a888f53c",
    "@moritzbrantner/ui": "git+https://github.com/moritzbrantner/ui.git#c50395394f46fa5ff119c452fca88e3dc2f9acf9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "xstate": "5.33.4"
  },
  "trustedDependencies": [
    "@moritzbrantner/ui"
  ]
}
